# Variáveis de ambiente do projeto.
# Copie este arquivo para .env.local e preencha os valores reais.
# Nunca faça commit de .env.local — ele está no .gitignore.

# APP_TEMPLATE_API_KEY=sua-chave-aqui

# Diretório alternativo para os dados locais da demonstração de notas.
# APP_TEMPLATE_DATA_DIR=C:/caminho/para/dados

# Nível de log para diagnóstico (DEBUG, INFO, WARNING, ERROR). Padrão: INFO.
# APP_TEMPLATE_LOG_LEVEL=DEBUG
