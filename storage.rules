rules_version = '2';
// Cole este conteudo em: Firebase Console > Storage > Regras.
//
// Regras do Acervo Visual Unificado.
// Mantem o mesmo criterio corporativo usado no Firestore: usuario autenticado,
// e-mail verificado e dominio @vitru.com.br.

service firebase.storage {
  match /b/{bucket}/o {
    function isCorporateUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@vitru[.]com[.]br$');
    }

    // Miniaturas JPG leves para visualizacao no acervo/site.
    match /acervo-visual-unificado/thumbnails/{source}/{year}/{fileName} {
      allow read: if isCorporateUser();
      allow write: if isCorporateUser()
        && request.resource.size < 20 * 1024 * 1024;
    }

    // Arquivos originais raster: jpg, jpeg, png etc.
    match /acervo-visual-unificado/originals/raster/{source}/{year}/{fileName} {
      allow read: if isCorporateUser();
      allow write: if isCorporateUser()
        && request.resource.size < 200 * 1024 * 1024;
    }

    // Arquivos originais vetoriais: eps, ai, svg.
    match /acervo-visual-unificado/originals/vector/{source}/{year}/{fileName} {
      allow read: if isCorporateUser();
      allow write: if isCorporateUser()
        && request.resource.size < 200 * 1024 * 1024;
    }

    // Caminho legado, mantido para arquivos/documentos antigos ja existentes.
    match /acervo-visual-unificado/images/{year}/{uuid}/{fileName} {
      allow read: if isCorporateUser();
      allow write: if isCorporateUser()
        && request.resource.size < 200 * 1024 * 1024;
    }
  }
}
