rules_version = '2';
// Cole este conteudo em: Firebase Console > Storage > Regras.

service firebase.storage {
  match /b/{bucket}/o {
    function isCorporateUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@vitru[.]com[.]br$');
    }

    // Unico caminho oficial: uma pasta por UUID, com original e tres derivacoes JPG.
    match /acervo-visual-unificado/{assetId}/{fileName} {
      allow read: if isCorporateUser();
      allow delete: if isCorporateUser();
      allow write: if isCorporateUser()
        && request.resource.size < 200 * 1024 * 1024;
    }
  }
}
