rules_version = '2';
// Cole este conteudo em: Firebase Console > Firestore Database > Regras.

service cloud.firestore {
  match /databases/{database}/documents {
    function isCorporateUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@vitru[.]com[.]br$');
    }

    function hasValidFiles() {
      return request.resource.data.files is map
        && request.resource.data.files.keys().hasAll(['original', 'large', 'medium', 'thumb']);
    }

    function isValidAsset() {
      return request.resource.data.keys().hasAll([
          'original_name',
          'knowledge_area',
          'visual_type',
          'colors',
          'description',
          'keywords',
          'extension',
          'orientation',
          'processed_at',
          'source',
          'sha256',
          'phash',
          'files'
        ])
        && !request.resource.data.keys().hasAny(['chave_numeracao'])
        && request.resource.data.visual_type in [
          'fotografia',
          'vetorial',
          'mockup',
          'textura-abstrato',
          'png',
          'editorial',
          'infografico',
          'mapas'
        ]
        && request.resource.data.colors is list
        && request.resource.data.colors.size() >= 1
        && request.resource.data.colors.size() <= 5
        && request.resource.data.colors.hasOnly([
          'rosa', 'vermelho', 'laranja', 'amarelo', 'verde', 'azul',
          'roxo', 'marrom', 'preto', 'cinza', 'branco'
        ])
        && request.resource.data.keywords is list
        && request.resource.data.keywords.size() == 15
        && hasValidFiles();
    }

    // Unico caminho oficial do acervo. O UUID tambem identifica a pasta no Storage.
    match /acervo-visual-unificado/{imageId} {
      allow read: if isCorporateUser();
      allow create: if isCorporateUser() && isValidAsset();
      allow update: if isCorporateUser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['files', 'sheet_synced'])
        && hasValidFiles();
      allow delete: if isCorporateUser();
    }
  }
}
